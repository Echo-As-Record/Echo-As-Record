# 复制为 deploy/.env 后填写。deploy/.env 不进仓库。

# ⑥ 客户端访问令牌（一人一套，只有一个令牌）
EAR_ACCESS_TOKEN=

# ⑦ 大模型入口对接的反代平台
EAR_LLM_BASE_URL=
EAR_LLM_API_KEY=

# Octopus 上传目录（录音、GPS、手机信息），由扫描服务读取
EAR_OCTOPUS_DIR=

# ② 适配器：旧 Ear Evidence API（直连旧 Ear 进程，端口每次挂载会变）
EAR_ADAPTER_EAR_URL=
EAR_ADAPTER_EAR_TOKEN=
# EAR_ADAPTER_DATA_ROOT=~/.octopus/local

# Codex 基线实验（experiments/codex_baselines，非产品）
# 实验用的 OpenAI key（A1a 听写、闭卷组）放在 shell 配置（如 ~/.zshrc：export EARbaseline_key=...），不写在这里；
# 不叫 OPENAI_API_KEY，以免 codex CLI 改走 API key 计费
# EAR_BASELINES_ROOT=experiments/codex_baselines/local-data
# EAR_BASELINES_TZ=Asia/Shanghai
# exam 容器经宿主代理上外网（Colima 下宿主是 192.168.5.2）
# EAR_BASELINES_EXAM_PROXY=http://192.168.5.2:7897
