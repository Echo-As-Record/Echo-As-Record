# Copy to deploy/.env manually; chmod 600. Never commit or log real values.
# This is only the storage slice; no adapter/extraction/API/LLM service is started.
# Generate independent random secrets privately. No defaults or test credentials.
EAR_POSTGRES_PASSWORD=
EAR_SERVICE_DB_PASSWORD=
# Use an alphabetic prefix followed by random URL-safe characters for NATS 2.11.
EAR_NATS_TOKEN=
EAR_STORAGE_IMAGE=ear-storage:local
EAR_STORAGE_PORT=8000

# Explicit new-database workflow (not run by ordinary up):
# docker compose --env-file deploy/.env -f deploy/compose.yaml build
# docker compose --env-file deploy/.env -f deploy/compose.yaml --profile init run --rm init-identities
# docker compose --env-file deploy/.env -f deploy/compose.yaml up -d
# Tokens: /run/secrets/ear/identities.env in the identities volume, mode 0600.
# init-identities never prints tokens, replaces a valid file, or rotates lost secrets.
# Use existing Bearer tokens through stdin/environment in operator clients, not argv/logs.
# The identities volume is a container-only deployment secret path, not a repo file.
# Back up DB and identities together; token recovery/rotation is an explicit operator action.
# Do not publish the PostgreSQL/NATS ports or print resolved Compose environments.

# Reserved for future modules; not consumed by this slice.
EAR_ACCESS_TOKEN=
EAR_LLM_BASE_URL=
EAR_LLM_API_KEY=
EAR_OCTOPUS_DIR=
